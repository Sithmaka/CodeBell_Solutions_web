# CodeBell support automations (n8n webhooks behind hooks.codebell.online).
# Leave any of these empty and the site falls back to email / WhatsApp for that feature.
# These URLs are public (they ship in the browser bundle) — never put secrets in VITE_ variables.

# n8n Chat Trigger production URL for CB-013 (Live Chat Support Agent)
VITE_CB_CHAT_URL=
# n8n webhook: create a support ticket (CB-WF-11)
VITE_CB_TICKET_URL=
# n8n webhook: ticket status lookup by ticket number + email (CB-WF-14)
VITE_CB_TICKET_STATUS_URL=
# Firebase public web configuration. These values identify the project but do
# not grant privileged access; Firestore rules and backend authorization do.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional local App Check debug token. Never commit a real debug token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Same-origin Vercel API routes are the defaults. Set only when intentionally
# calling Firebase Functions directly (for example, local emulator testing).
VITE_CB_LEADS_API_URL=
VITE_CB_CRM_API_URL=

# GA4 remains disabled when this is empty. Do not place personal data in events.
VITE_GA4_MEASUREMENT_ID=

# Vercel server-only environment (never prefix these with VITE_).
FIREBASE_LEADS_API_URL=
FIREBASE_CRM_API_URL=
LEAD_PROXY_SHARED_SECRET=
ALLOWED_API_ORIGINS=https://www.codebell.online,https://codebell.online

# Firebase Functions parameters/secrets are configured with Firebase CLI or
# Google Secret Manager, not committed environment files.
# ALLOWED_ORIGINS=https://www.codebell.online,https://codebell.online
# REQUIRE_APP_CHECK=false
# REQUIRE_TRUSTED_PROXY=true
# IP_HASH_SECRET=
# LEAD_PROXY_SHARED_SECRET=
# N8N_WEBHOOK_URL=
# N8N_SIGNING_SECRET=
